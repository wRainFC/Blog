    "test:studio": "vitest run tools/content-studio",
    "test:unit": "vitest run src/lib/content"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.1",
    "astro-expressive-code": "0.44.0",
    "katex": "0.17.0",
    "rehype-callouts": "2.2.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "pagefind": "1.5.2",
    "sharp": "0.34.5",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true
  }
