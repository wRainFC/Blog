{
  "name": "yanbian-ink-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "studio": "node tools/content-studio/start.mjs",
    "build": "astro build && pagefind --site dist",
