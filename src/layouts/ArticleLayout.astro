---
import BaseLayout from "./BaseLayout.astro";
import type { Course } from "../lib/content/queries";
import { courseHref, topicHref } from "../lib/content/urls";
import ArticleMeta from "../components/article/ArticleMeta.astro";
import ArticleToc from "../components/article/ArticleToc.astro";

interface Heading { depth: number; slug: string; text: string }
interface Props {
  title: string;
  summary: string;
  pubDate: Date;
  updated?: Date;
  tags: string[];
  type: "note" | "essay";
  course?: Course;
  chapter?: string;
  headings?: Heading[];
  readingTime?: string;
}

const {
  title, summary, pubDate, updated, tags, type, course, chapter,
  headings = [], readingTime = "约 4 分钟阅读",
} = Astro.props;
---

<BaseLayout title={`${title}｜楚地之雨`} description={summary}>
  <article class="article-shell" data-pagefind-body>
    <header class="article-header">
      <p class="article-breadcrumb">
        <a href={type === "note" && course ? courseHref(course.id) : "/writing"}>{type === "note" ? "课程笔记" : "随笔思考"}</a>
        <span>/</span>
        <span>{course?.data.title || "片刻所思"}</span>
      </p>
      <h1>{title}</h1>
      <p class="article-summary">{summary}</p>
      <ArticleMeta pubDate={pubDate} updated={updated} readingTime={readingTime} />
      {type === "note" && (
        <div class="course-stamp">
          <span>{course?.data.title}</span><i></i><span>{course?.data.semester}</span><i></i><span>{chapter}</span>
        </div>
      )}
    </header>

    <div class="article-grid">
      <div class="article-body prose">
        <slot />
        <div class="article-tags">
          {tags.map((tag) => <a href={topicHref(tag)}>#{tag}</a>)}
        </div>
      </div>

      <ArticleToc headings={headings} />
    </div>
  </article>
</BaseLayout>
