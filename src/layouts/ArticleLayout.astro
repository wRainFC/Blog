---
import BaseLayout from "./BaseLayout.astro";
import type { Article, Course, CourseOutlineGroup, Note } from "../lib/content/queries";
import { courseHref, topicHref } from "../lib/content/urls";
import { withBasePath } from "../lib/site-path";
import ArticleMeta from "../components/article/ArticleMeta.astro";
import ArticleToc from "../components/article/ArticleToc.astro";
import CourseNavigator from "../components/article/CourseNavigator.astro";
import CourseArticleNav from "../components/article/CourseArticleNav.astro";
import RelatedArticles from "../components/article/RelatedArticles.astro";

interface Heading { depth: number; slug: string; text: string }
interface Props {
  title: string;
  summary: string;
  pubDate: Date;
  updated?: Date;
  tags: string[];
  type: "note" | "essay";
  course?: Course;
  chapter?: string;
  chapterId?: string;
  courseOutline?: CourseOutlineGroup[];
  currentNoteId?: string;
  previousNote?: Note;
  nextNote?: Note;
  previousChapter?: string;
  nextChapter?: string;
  relatedArticles?: Article[];
  headings?: Heading[];
  readingTime?: string;
  motionId?: string;
}

const {
  title, summary, pubDate, updated, tags, type, course, chapter, chapterId,
  courseOutline = [], currentNoteId, previousNote, nextNote, previousChapter, nextChapter,
  headings = [], readingTime = "约 4 分钟阅读",
  relatedArticles = [],
  motionId,
} = Astro.props;
const hasCourseNavigation = type === "note" && Boolean(course) && Boolean(currentNoteId) && courseOutline.length > 0;
const effectiveDate = updated ?? pubDate;
const now = new Date();
const age = now.getTime() - effectiveDate.getTime();
const timeFilter = age <= 30 * 24 * 60 * 60 * 1000
  ? "近 30 天"
  : age <= 365 * 24 * 60 * 60 * 1000 ? "近 1 年" : "更早";
---

<BaseLayout title={`${title}｜楚地之雨`} description={summary} pageKind="article">
  <article class="article-shell" data-pagefind-body>
    <header class="article-header">
      <p class="article-breadcrumb">
        <a href={type === "note" && course ? courseHref(course.id) : withBasePath("/writing")}>{type === "note" ? "学习" : "写作"}</a>
        <span>/</span>
        <span>{course?.data.title || "随笔"}</span>
      </p>
      <h1><span data-motion-title={motionId}>{title}</span></h1>
      <p class="article-summary">{summary}</p>
      <ArticleMeta pubDate={pubDate} updated={updated} readingTime={readingTime} />
      {type === "note" && (
        <div class="course-stamp">
          <span>{course?.data.title}</span><i></i><span>{course?.data.semester}</span><i></i><span>{chapter}</span>
        </div>
      )}
    </header>

    {hasCourseNavigation && (
      <CourseNavigator
        course={course!}
        outline={courseOutline}
        currentNoteId={currentNoteId!}
        currentChapterId={chapterId}
        variant="mobile"
      />
    )}

    <ArticleToc headings={headings} variant="mobile" />

    <div class:list={["article-grid", { "article-grid--course": hasCourseNavigation }]}>
      {hasCourseNavigation && (
        <CourseNavigator
          course={course!}
          outline={courseOutline}
          currentNoteId={currentNoteId!}
          currentChapterId={chapterId}
          variant="desktop"
        />
      )}
      <div class="article-body prose">
        <div class="article-index-meta" aria-hidden="true">
          <span data-pagefind-filter="类型">{type === "note" ? "笔记" : "随笔"}</span>
          {course && <span data-pagefind-filter="课程">{course.data.title}</span>}
          {tags.map((tag) => <span data-pagefind-filter="标签">{tag}</span>)}
          <span data-pagefind-filter="时间">{timeFilter}</span>
        </div>
        <slot />
        <div class="article-tags">
          {tags.map((tag) => <a href={topicHref(tag)}>#{tag}</a>)}
        </div>
        {hasCourseNavigation && (
          <CourseArticleNav
            previousNote={previousNote}
            nextNote={nextNote}
            previousChapter={previousChapter !== chapter ? previousChapter : undefined}
            nextChapter={nextChapter !== chapter ? nextChapter : undefined}
          />
        )}
        <RelatedArticles articles={relatedArticles} />
      </div>

      <ArticleToc headings={headings} variant="desktop" />
    </div>
  </article>
</BaseLayout>
