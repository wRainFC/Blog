---
import "katex/dist/katex.min.css";
import "rehype-callouts/theme/github";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/prose.css";
import "../styles/theme-transition.css";
import "../styles/motion.css";
import Header from "../components/shell/Header.astro";
import Footer from "../components/shell/Footer.astro";
import { siteConfig } from "../config/site";
import { ClientRouter } from "astro:transitions";
import { withBasePath } from "../lib/site-path";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  headerVariant?: "default" | "overlay";
  pageKind?: "home" | "archive" | "article" | "utility";
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = "/og.png",
  headerVariant = "default",
  pageKind = "utility",
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const imageUrl = new URL(withBasePath(image), Astro.site ?? Astro.url);
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f1ec" data-theme-color />
    <script is:inline>
      (() => {
        const key = "wrain-theme";
        let saved = null;
        try { saved = localStorage.getItem(key); } catch {}
        const theme = saved === "light" || saved === "dark"
          ? saved
          : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[data-theme-color]')?.setAttribute(
          "content",
          theme === "dark" ? "#101411" : "#f3f1ec",
        );
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBasePath("/favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.rssTitle} href={withBasePath("/rss.xml")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="楚地之雨" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <ClientRouter fallback="animate" />
    <title>{title}</title>
  </head>
  <body
    class:list={{ "has-overlay-header": headerVariant === "overlay", "document-theme": headerVariant !== "overlay" }}
    data-page-kind={pageKind}
  >
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Header variant={headerVariant} />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>

<script>
  import { setupThemeControls } from "../scripts/theme";
  import { setupSiteMotion } from "../scripts/site-motion";

  const lifecycle = window as Window & { __wrainPageLifecycle?: boolean };
  const setupPage = () => {
    setupThemeControls();
    setupSiteMotion();
  };

  setupPage();
  if (!lifecycle.__wrainPageLifecycle) {
    lifecycle.__wrainPageLifecycle = true;
    document.addEventListener("astro:page-load", setupPage);
  }
</script>
