---
interface Props {
  size?: "compact" | "hero" | "footer";
  inverse?: boolean;
}

const { size = "compact", inverse = false } = Astro.props;
---

<span
  class:list={["wrain-wordmark", `is-${size}`, { "is-inverse": inverse }]}
  aria-label="wRainFC，From Chu"
>
  <span class="wordmark-visual" aria-hidden="true">
    <span class="wordmark-name">wRain</span>
    <span class="wordmark-divider"></span>
    <span class="wordmark-expansion">From Chu</span>
  </span>
</span>

<style>
  .wrain-wordmark,
  .wordmark-visual,
  .wordmark-divider,
  .wordmark-expansion {
    display: inline-flex;
    align-items: center;
  }

  .wordmark-visual {
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark-name {
    font-weight: 680;
    letter-spacing: -.065em;
  }

  .wordmark-divider {
    width: .32em;
    height: .32em;
    margin: 0 .48em;
    border-radius: 50%;
    background: var(--accent);
  }

  .wordmark-expansion {
    color: var(--ink-faint);
    font-size: .43em;
    font-weight: 620;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .is-compact { font-size: 18px; }
  .is-hero { font-size: clamp(24px, 3vw, 34px); }
  .is-footer { font-size: 21px; }

  .is-inverse .wordmark-visual { color: var(--footer-wordmark, var(--on-accent)); }
  .is-inverse .wordmark-expansion { color: var(--footer-fg-muted, rgba(242,247,255,.52)); }
</style>
