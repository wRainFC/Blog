---
import Wordmark from "./Wordmark.astro";
import { navigation } from "../../config/site";

const year = new Date().getFullYear();
const links = [
  ...navigation,
  { href: "/search", label: "搜索" },
  { href: "/rss.xml", label: "RSS 订阅" },
];
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="footer-inner">
    <div class="footer-row footer-top">
      <span class="footer-brand"><Wordmark size="footer" /></span>
      <nav class="footer-nav" aria-label="页脚导航">
        {links.map((link) => (
          <a href={link.href} data-astro-reload={link.href === "/rss.xml" ? true : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
    </div>
    <div class="footer-row footer-bottom">
      <p class="footer-copyright">© {year} wRainFC</p>
      <p class="footer-epigraph">持续学习，保持清醒，也保留一点好奇。</p>
    </div>
  </div>
</footer>
