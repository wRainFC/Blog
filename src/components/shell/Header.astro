---
import Wordmark from "./Wordmark.astro";
import { navigation } from "../../config/site";
import { withBasePath, withoutBasePath } from "../../lib/site-path";

interface Props {
  variant?: "default" | "overlay";
}

const { variant = "default" } = Astro.props;
const pathname = withoutBasePath(Astro.url.pathname);
const links = navigation;
---

<header
  class:list={["site-header", { "is-overlay": variant === "overlay" }]}
  data-pagefind-ignore
  transition:name="site-header"
  transition:animate="none"
>
  <div class="header-inner">
    <a class="brand" href={withBasePath("/")} aria-label="wRainFC 首页">
      <Wordmark />
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {links.map((link) => (
        <a
          href={withBasePath(link.href)}
          aria-current={pathname.startsWith(link.href) ? "page" : undefined}
        >
          {link.label}
          {pathname.startsWith(link.href) && (
            <span class="nav-current-indicator" aria-hidden="true"></span>
          )}
        </a>
      ))}
      <span class="nav-actions">
        <a
          class="search-link"
          href={withBasePath("/search")}
          aria-label="搜索文章"
          aria-current={pathname.startsWith("/search") ? "page" : undefined}
        >
          <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="M15.4 15.4 20 20" />
          </svg>
          <span>搜索</span>
          {pathname.startsWith("/search") && (
            <span class="nav-current-indicator" aria-hidden="true"></span>
          )}
        </a>
        <button class="theme-control" type="button" data-theme-control aria-pressed="false" aria-label="切换至深色主题" title="切换至深色主题">
          <svg class="theme-control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <g class="theme-control-sun"><circle cx="12" cy="12" r="3.4" /><path d="M12 2.5v2.3m0 14.4v2.3M2.5 12h2.3m14.4 0h2.3M5.3 5.3 7 7m10 10 1.7 1.7m0-13.4L17 7M7 17l-1.7 1.7" /></g>
            <path class="theme-control-moon" d="M17.2 18.1A8.3 8.3 0 0 1 9.1 4.2a8.4 8.4 0 1 0 8.1 13.9Z" />
          </svg>
          <span data-theme-control-label>切换至深色主题</span>
        </button>
      </span>
    </nav>

    <button
      class="mobile-menu-toggle"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-navigation"
      aria-label="打开导航"
    >
      <span></span><span></span>
    </button>

    <div class="mobile-menu-panel" id="mobile-navigation" data-mobile-menu hidden>
      <div class="mobile-menu-heading" aria-hidden="true">
        <span>Navigation</span><span>wRain / FC</span>
      </div>
      <nav aria-label="移动端导航">
        {links.map((link) => (
          <a href={withBasePath(link.href)} aria-current={pathname.startsWith(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))}
        <a href={withBasePath("/search")} aria-current={pathname.startsWith("/search") ? "page" : undefined}>搜索</a>
        <button class="theme-control" type="button" data-theme-control aria-pressed="false" aria-label="切换至深色主题" title="切换至深色主题">
          <svg class="theme-control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <g class="theme-control-sun"><circle cx="12" cy="12" r="3.4" /><path d="M12 2.5v2.3m0 14.4v2.3M2.5 12h2.3m14.4 0h2.3M5.3 5.3 7 7m10 10 1.7 1.7m0-13.4L17 7M7 17l-1.7 1.7" /></g>
            <path class="theme-control-moon" d="M17.2 18.1A8.3 8.3 0 0 1 9.1 4.2a8.4 8.4 0 1 0 8.1 13.9Z" />
          </svg>
          <span data-theme-control-label>切换至深色主题</span>
        </button>
      </nav>
      <p>课程、技术与日常思考的个人索引。</p>
    </div>
  </div>
  <span
    class="reading-progress-track"
    data-reading-progress
    role="progressbar"
    aria-label="阅读进度"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <span data-reading-progress-bar></span>
  </span>
</header>
