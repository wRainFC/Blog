<section class="ink-hero" data-ink-hero>
  <div class="hero-grain" aria-hidden="true"></div>
  <div class="hero-content">
    <p class="hero-kicker" data-hero-item>一名大学生的学习札记</p>
    <h1 data-hero-item>把学过的，<br /><em>写成自己的。</em></h1>
    <p class="hero-intro" data-hero-item>
      在课程、书页与日常之间，整理知识的脉络，<br class="desktop-only" />也记录那些缓慢生长的想法。
    </p>
    <div class="hero-actions" data-hero-item>
      <a class="primary-button" href="/notes">进入笔记</a>
      <a class="text-button" href="/essays">阅读随笔 <span>↗</span></a>
    </div>
  </div>

  <div class="hero-art" aria-hidden="true" data-ink-surface>
    <div class="mist mist-one" data-mountain></div>
    <div class="mountain mountain-far" data-mountain></div>
    <div class="mountain mountain-mid" data-mountain></div>
    <div class="mountain mountain-near" data-mountain></div>
    <div class="water-line" data-mountain></div>
    <div class="sun-seal" data-mountain>砚</div>
    <div class="ink-orbit ink-orbit-one"></div>
    <div class="ink-orbit ink-orbit-two"></div>
  </div>

  <p class="hero-note" data-hero-item><span></span> 移动指针，落一笔墨</p>
</section>

<script>
  import { animate, stagger } from "motion";

  const hero = document.querySelector<HTMLElement>("[data-ink-hero]");
  const surface = hero?.querySelector<HTMLElement>("[data-ink-surface]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (hero && surface && !reduced) {
    let hasPlayed = false;
    try {
      hasPlayed = sessionStorage.getItem("yanbian-intro-played") === "yes";
      sessionStorage.setItem("yanbian-intro-played", "yes");
    } catch {
      hasPlayed = false;
    }

    if (hasPlayed) {
      animate(hero, { opacity: [0, 1] }, { duration: 0.35 });
    } else {
      animate("[data-mountain]", {
        opacity: [0, 1],
        transform: ["translateY(42px) scale(1.04)", "translateY(0) scale(1)"],
      }, { delay: stagger(0.13), duration: 1.35, ease: [0.22, 1, 0.36, 1] });

      animate("[data-hero-item]", {
        opacity: [0, 1],
        transform: ["translateY(18px)", "translateY(0)"],
      }, { delay: stagger(0.1, { startDelay: 0.36 }), duration: 0.75, ease: "easeOut" });
    }

    let active = true;
    let lastX = 0;
    let lastY = 0;
    let lastTime = 0;
    let inkCount = 0;

    const spawnInk = (clientX: number, clientY: number, force = false) => {
      if (!active || inkCount >= 12) return;
      const now = performance.now();
      const distance = Math.hypot(clientX - lastX, clientY - lastY);
      if (!force && (now - lastTime < 80 || distance < 46)) return;

      const rect = surface.getBoundingClientRect();
      if (
        clientX < rect.left || clientX > rect.right ||
        clientY < rect.top || clientY > rect.bottom
      ) return;

      lastX = clientX;
      lastY = clientY;
      lastTime = now;
      inkCount += 1;

      const blot = document.createElement("span");
      blot.className = "ink-blot";
      const size = 42 + Math.random() * 72;
      blot.style.width = `${size}px`;
      blot.style.height = `${size * (0.72 + Math.random() * 0.3)}px`;
      blot.style.left = `${clientX - rect.left}px`;
      blot.style.top = `${clientY - rect.top}px`;
      blot.style.setProperty("--blot-rotate", `${Math.random() * 180}deg`);
      surface.appendChild(blot);

      animate(blot, {
        opacity: [0, 0.18, 0],
        transform: ["translate(-50%, -50%) scale(.45) rotate(var(--blot-rotate))", "translate(-50%, -50%) scale(1.35) rotate(var(--blot-rotate))"],
      }, { duration: 1.05, ease: "easeOut" }).then(() => {
        blot.remove();
        inkCount -= 1;
      });
    };

    surface.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "touch") spawnInk(event.clientX, event.clientY);
    });
    surface.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "touch") spawnInk(event.clientX, event.clientY, true);
    }, { passive: true });

    const observer = new IntersectionObserver(([entry]) => {
      active = entry.isIntersecting;
    }, { threshold: 0.05 });
    observer.observe(hero);
  }
</script>
