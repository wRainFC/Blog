---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { byNewest } from "../../lib/content";

export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  const courses = [...new Set(notes.map((note) => note.data.courseSlug))];
  return courses.map((course) => ({ params: { course } }));
}

const courseSlug = Astro.params.course;
const notes = byNewest((await getCollection("notes", ({ data }) => !data.draft && data.courseSlug === courseSlug)));
const course = notes[0]?.data.course || "课程";
const semester = notes[0]?.data.semester || "";
---

<BaseLayout title={`${course}｜楚地之雨`} description={`${course}课程笔记归档。`}>
  <section class="page-hero compact-hero course-page-hero">
    <p class="section-index">{semester}</p>
    <h1>{course}</h1>
    <p>沿着章节继续向前，也随时回到概念的起点。</p>
  </section>
  <section class="single-archive" data-pagefind-body>
    <div class="archive-summary"><span>{notes.length} 篇笔记</span><i></i><a href="/notes">返回全部课程</a></div>
    <div class="article-list">
      {notes.map((note) => (
        <ArticleCard
          href={`/notes/${note.id}`}
          title={note.data.title}
          summary={note.data.summary}
          date={note.data.pubDate}
          kind="笔记"
          eyebrow={note.data.chapter}
        />
      ))}
    </div>
  </section>
</BaseLayout>
