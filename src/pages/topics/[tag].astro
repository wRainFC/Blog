---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/article/ArticleCard.astro";
import { getPublishedArticles, getArticlesByTopic, getCourseById } from "../../lib/content/queries";
import { articleHref, articleMotionId } from "../../lib/content/urls";

export async function getStaticPaths() {
  const entries = await getPublishedArticles();
  const tags = [...new Set(entries.flatMap((entry) => entry.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const entries = await getArticlesByTopic(tag);
const noteCourses = await Promise.all(
  entries
    .filter((entry) => entry.collection === "notes")
    .map(async (entry) => [entry.data.course.id, await getCourseById(entry.data.course.id)] as const),
);
const courseNames = new Map(noteCourses.map(([id, course]) => [id, course?.data.title]));
---

<BaseLayout title={`#${tag}｜楚地之雨`} description={`与“${tag}”相关的笔记和随笔。`} pageKind="archive">
  <section class="page-hero compact-hero">
    <p class="section-index">TOPIC ARCHIVE</p>
    <h1>#{tag}</h1>
    <p>围绕这一主题收录的课程笔记与随笔。</p>
  </section>
  <section class="single-archive" data-pagefind-body data-reveal>
    <div class="archive-summary reveal-item"><span>{entries.length} 篇内容</span></div>
    <div class="article-list">
      {entries.map((entry) => {
        const isNote = entry.collection === "notes";
        return (
          <ArticleCard
            href={articleHref(entry)}
            title={entry.data.title}
            summary={entry.data.summary}
            date={entry.data.pubDate}
            kind={isNote ? "笔记" : "随笔"}
            eyebrow={isNote ? courseNames.get(entry.data.course.id) : entry.data.tags[0]}
            class="reveal-item"
            motionId={articleMotionId(entry)}
          />
        );
      })}
    </div>
  </section>
</BaseLayout>
