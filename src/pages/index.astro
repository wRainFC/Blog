---
import "../styles/home.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import InkHero from "../components/home/InkHero.astro";
import ArticleCard from "../components/article/ArticleCard.astro";
import { getCourseSummaries, getPublishedEssays, getPublishedNotes, byNewest } from "../lib/content/queries";
import { articleHref, courseHref } from "../lib/content/urls";

const [notes, essays, courses] = await Promise.all([
  getPublishedNotes(),
  getPublishedEssays(),
  getCourseSummaries(),
]);
const featuredEssay = essays.find((essay) => essay.data.featured) || essays[0];
const latest = byNewest([...notes, ...essays])
  .filter((entry) => !(entry.collection === "essays" && entry.id === featuredEssay?.id))
  .slice(0, 3);
const courseNames = new Map(courses.map((course) => [course.id, course.data.title]));
const featuredHref = featuredEssay ? articleHref(featuredEssay) : undefined;
---

<BaseLayout headerVariant="overlay">
  <InkHero />

  <section class="home-section home-editorial home-content-bridge" data-home-reveal aria-labelledby="featured-title">
    <div class="recent-shell">
      <header class="recent-header reveal-item">
        <div class="recent-heading">
          <span class="recent-index" aria-hidden="true">01</span>
          <div>
            <p class="recent-kicker">SELECTED WRITING</p>
            <h2 id="featured-title">最近写下</h2>
          </div>
        </div>
        <a class="recent-archive-link" href="/writing">全部文章 <span aria-hidden="true">↗</span></a>
      </header>

      <div class="recent-layout">
        {featuredEssay && (
          <a class="recent-feature reveal-item" href={featuredHref}>
            <div class="recent-feature-meta">
              <span>FEATURED ESSAY</span>
              <time datetime={featuredEssay.data.pubDate.toISOString()}>
                {featuredEssay.data.pubDate.getFullYear()}
              </time>
            </div>
            <div class="recent-feature-copy">
              <h3>{featuredEssay.data.title}</h3>
              <p>{featuredEssay.data.summary}</p>
            </div>
            <span class="recent-feature-link">阅读全文 <i aria-hidden="true">↗</i></span>
          </a>
        )}

        <div class="recent-latest reveal-item" aria-label="近日更新">
          <div class="recent-latest-heading">
            <p>LATEST UPDATES</p>
            <span>近期更新</span>
          </div>
          <div class="recent-table">
            {latest.map((entry) => {
              const isNote = entry.collection === "notes";
              return (
                <ArticleCard
                  href={articleHref(entry)}
                  title={entry.data.title}
                  summary={entry.data.summary}
                  date={entry.data.pubDate}
                  kind={isNote ? "笔记" : "随笔"}
                  eyebrow={isNote ? courseNames.get(entry.data.course.id) : entry.data.tags[0]}
                />
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section home-courses" data-home-reveal aria-labelledby="courses-title">
    <div class="section-heading reveal-item">
      <div>
        <p class="section-index">02 / LEARNING NOTES</p>
        <h2 id="courses-title">正在学习</h2>
      </div>
      <a href="/learn">进入知识库 <span>→</span></a>
    </div>

    <div class="course-grid">
      {courses.map((course, index) => (
        <a
          class="course-row reveal-item"
          href={courseHref(course.id)}
          style={`--reveal-order: ${index}`}
        >
          <span class="course-no">{String(index + 1).padStart(2, "0")}</span>
          <p class="course-term">{course.data.semester}</p>
          <h3>{course.data.title}</h3>
          <p class="course-count">{course.count} 篇笔记</p>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </div>
  </section>

  <aside class="home-coda reveal-item" data-home-reveal aria-label="写作寄语">
    <p>雨是悲欢离合，雨是一生过错</p>
    <span>— 我请求: 雨</span>
  </aside>
</BaseLayout>

<script>
  const revealTargets = [...document.querySelectorAll<HTMLElement>("[data-home-reveal]")];
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let revealObserver: IntersectionObserver | undefined;

  if (!reduceMotion.matches && "IntersectionObserver" in window) {
    document.documentElement.classList.add("home-motion");
    revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: .12, rootMargin: "0px 0px -10%" });
    revealTargets.forEach((target) => revealObserver?.observe(target));
  } else {
    revealTargets.forEach((target) => target.classList.add("is-visible"));
  }

  const cleanupReveal = () => {
    revealObserver?.disconnect();
    document.documentElement.classList.remove("home-motion");
    document.removeEventListener("astro:before-swap", cleanupReveal);
    window.removeEventListener("pagehide", cleanupReveal);
  };

  document.addEventListener("astro:before-swap", cleanupReveal, { once: true });
  window.addEventListener("pagehide", cleanupReveal, { once: true });
</script>
