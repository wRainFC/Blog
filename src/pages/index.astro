---
import "../styles/home.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import InkHero from "../components/home/InkHero.astro";
import ArticleCard from "../components/article/ArticleCard.astro";
import { getCourseSummaries, getPublishedEssays, getPublishedNotes, byNewest } from "../lib/content/queries";
import { articleHref, courseHref } from "../lib/content/urls";

const [notes, essays, courses] = await Promise.all([
  getPublishedNotes(),
  getPublishedEssays(),
  getCourseSummaries(),
]);
const recent = byNewest([...notes, ...essays]).slice(0, 4);
const courseNames = new Map(courses.map((course) => [course.id, course.data.title]));
---

<BaseLayout headerVariant="overlay">
  <InkHero />

  <section class="home-section home-content-bridge" data-reveal aria-labelledby="recent-title">
    <header class="section-heading reveal-item">
      <div>
        <p class="section-index">01 / RECENT</p>
        <h2 id="recent-title">最近更新</h2>
      </div>
      <a href="/writing">全部文章 <span aria-hidden="true">→</span></a>
    </header>

    <div class="home-recent-list article-list reveal-item">
      {recent.map((entry) => {
        const isNote = entry.collection === "notes";
        return (
          <ArticleCard
            href={articleHref(entry)}
            title={entry.data.title}
            summary={entry.data.summary}
            date={entry.data.pubDate}
            kind={isNote ? "笔记" : "随笔"}
            eyebrow={isNote ? courseNames.get(entry.data.course.id) : entry.data.tags[0]}
          />
        );
      })}
    </div>
  </section>

  <section class="home-section home-courses" data-reveal aria-labelledby="courses-title">
    <header class="section-heading reveal-item">
      <div>
        <p class="section-index">02 / LEARNING NOTES</p>
        <h2 id="courses-title">正在学习</h2>
      </div>
      <a href="/learn">进入知识库 <span>→</span></a>
    </header>

    <div class="course-grid reveal-item">
      {courses.map((course, index) => (
        <a
          class="course-row"
          href={courseHref(course.id)}
        >
          <span class="course-meta">
            <span class="kind-mark">课程</span>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <span>{course.data.semester} · {course.count} 篇笔记</span>
          </span>
          <h3>{course.data.title}</h3>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import { setupScrollReveal } from "../scripts/reveal";

  setupScrollReveal();
</script>
