---
import "../styles/home.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialHero from "../components/home/EditorialHero.astro";
import ArticleCard from "../components/article/ArticleCard.astro";
import heroImage from "../assets/home-hero.jpg";
import { getCourseSummaries, getPublishedEssays, getPublishedNotes, byNewest } from "../lib/content/queries";
import { articleHref, articleMotionId, courseHref } from "../lib/content/urls";

const [notes, essays, courses] = await Promise.all([
  getPublishedNotes(),
  getPublishedEssays(),
  getCourseSummaries(),
]);
const recent = byNewest([...notes, ...essays]).slice(0, 4);
const courseNames = new Map(courses.map((course) => [course.id, course.data.title]));
const latestByCourse = new Map<string, Date>();
for (const note of notes) {
  const courseId = note.data.course.id;
  const current = latestByCourse.get(courseId);
  if (!current || note.data.pubDate > current) latestByCourse.set(courseId, note.data.pubDate);
}
const formatMonth = (date?: Date) => date
  ? new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit" }).format(date)
  : "尚未更新";
---

<BaseLayout headerVariant="overlay" pageKind="home">
  <EditorialHero image={heroImage} imageAlt="浅蓝色双马尾动漫少女抱膝而坐，肩旁趴着一只小动物" />

  <section class="home-section home-content-bridge" id="recent" data-reveal aria-labelledby="recent-title">
    <header class="section-heading reveal-item">
      <div>
        <p class="section-index">01 / LATEST</p>
        <h2 id="recent-title">最近更新</h2>
      </div>
      <a href="/writing">查看全部 <span aria-hidden="true">↗</span></a>
    </header>

    <div class="home-recent-list article-list reveal-item">
      {recent.map((entry) => {
        const isNote = entry.collection === "notes";
        return (
          <ArticleCard
            href={articleHref(entry)}
            title={entry.data.title}
            summary={entry.data.summary}
            date={entry.data.pubDate}
            kind={isNote ? "笔记" : "随笔"}
            eyebrow={isNote ? courseNames.get(entry.data.course.id) : entry.data.tags[0]}
            motionId={articleMotionId(entry)}
          />
        );
      })}
    </div>
  </section>

  <section class="home-section home-courses" data-reveal aria-labelledby="courses-title">
    <header class="section-heading reveal-item">
      <div>
        <p class="section-index">02 / COURSES</p>
        <h2 id="courses-title">课程索引</h2>
      </div>
      <a href="/learn">全部课程 <span>↗</span></a>
    </header>

    <div class="course-grid reveal-item">
      {courses.map((course, index) => (
        <a
          class="course-row"
          href={courseHref(course.id)}
        >
          <span class="course-meta">
            <span class="kind-mark">课程</span>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <span>{course.data.semester} · {course.count} 篇笔记</span>
          </span>
          <h3><span>{course.data.title}</span></h3>
          <span class="course-updated">更新于 {formatMonth(latestByCourse.get(course.id))}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
