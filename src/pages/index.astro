---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import InkHero from "../components/InkHero.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { byNewest } from "../lib/content";

const notes = byNewest((await getCollection("notes", ({ data }) => !data.draft)));
const essays = byNewest((await getCollection("essays", ({ data }) => !data.draft)));
const featuredEssay = essays.find((essay) => essay.data.featured) || essays[0];
const latest = byNewest([...notes, ...essays])
  .filter((entry) => !(entry.collection === "essays" && entry.id === featuredEssay?.id))
  .slice(0, 3);

const courseMap = new Map<string, { name: string; slug: string; semester: string; count: number }>();
for (const note of notes) {
  const key = note.data.courseSlug;
  const current = courseMap.get(key);
  courseMap.set(key, {
    name: note.data.course,
    slug: key,
    semester: note.data.semester,
    count: (current?.count || 0) + 1,
  });
}
const courses = [...courseMap.values()];
const articleCount = notes.length + essays.length;
---

<BaseLayout headerVariant="overlay">
  <InkHero courseCount={courses.length} articleCount={articleCount} />

  <section class="home-section home-editorial" aria-labelledby="featured-title">
    <div class="section-heading">
      <div>
        <p class="section-index">01 / SELECTED WRITING</p>
        <h2 id="featured-title">最近，落笔于此</h2>
      </div>
      <a href="/essays">全部文章 <span>→</span></a>
    </div>

    <div class="editorial-grid">
      {featuredEssay && (
        <a class="editorial-lead" href={`/essays/${featuredEssay.id}`}>
          <div class="editorial-lead-meta">
            <span>FEATURED ESSAY</span>
            <time datetime={featuredEssay.data.pubDate.toISOString()}>
              {featuredEssay.data.pubDate.getFullYear()}
            </time>
          </div>
          <div class="editorial-lead-copy">
            <p class="editorial-mark" aria-hidden="true">思</p>
            <h3>{featuredEssay.data.title}</h3>
            <p>{featuredEssay.data.summary}</p>
          </div>
          <span class="editorial-lead-link">阅读全文 <i aria-hidden="true">↗</i></span>
        </a>
      )}

      <div class="editorial-latest" aria-label="近日更新">
        <p class="editorial-latest-label">近日更新 · LATEST</p>
        <div class="article-list">
          {latest.map((entry) => {
            const isNote = entry.collection === "notes";
            return (
              <ArticleCard
                href={`/${isNote ? "notes" : "essays"}/${entry.id}`}
                title={entry.data.title}
                summary={entry.data.summary}
                date={entry.data.pubDate}
                kind={isNote ? "笔记" : "随笔"}
                eyebrow={isNote ? entry.data.course : entry.data.tags[0]}
              />
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <section class="home-section home-courses" aria-labelledby="courses-title">
    <div class="section-heading">
      <div>
        <p class="section-index">02 / LEARNING NOTES</p>
        <h2 id="courses-title">正在学习</h2>
      </div>
      <a href="/notes">进入知识库 <span>→</span></a>
    </div>

    <div class="course-grid">
      {courses.map((course, index) => (
        <a class="course-row" href={`/courses/${course.slug}`}>
          <span class="course-no">{String(index + 1).padStart(2, "0")}</span>
          <p class="course-term">{course.semester}</p>
          <h3>{course.name}</h3>
          <p class="course-count">{course.count} 篇笔记</p>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </div>
  </section>

  <aside class="home-coda" aria-label="写作寄语">
    <p>读书如行远路，落笔似见群山。</p>
    <span>— 在确定与未定之间，留下此刻的理解</span>
  </aside>
</BaseLayout>
