---
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getPublishedEssays } from "../../lib/content/queries";
import { readingTime } from "../../lib/content/format";
import { articleMotionId } from "../../lib/content/urls";

export async function getStaticPaths() {
  const essays = await getPublishedEssays();
  return essays.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  summary={entry.data.summary}
  pubDate={entry.data.pubDate}
  updated={entry.data.updated}
  tags={entry.data.tags}
  type="essay"
  headings={headings}
  readingTime={readingTime(entry.body)}
  motionId={articleMotionId(entry)}
>
  <Content />
</ArticleLayout>
