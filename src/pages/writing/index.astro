---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/article/ArticleCard.astro";
import { getPublishedEssays } from "../../lib/content/queries";
import { articleHref } from "../../lib/content/urls";

const essays = await getPublishedEssays();
---

<BaseLayout title="随笔思考｜楚地之雨" description="关于学习、成长和日常观察的个人随笔。">
  <section class="page-hero essay-hero">
    <p class="section-index">ESSAYS & THOUGHTS</p>
    <h1>我们经历过的每一个日常，<br />就是接连不断发生的奇迹。</h1>
    <p>随便写点什么</p>
  </section>
  <section class="essay-archive" data-pagefind-body data-reveal>
    {essays.map((essay, index) => (
      <div class="essay-row reveal-item" style={`--reveal-order: ${index}`}>
        <span class="essay-index">{String(index + 1).padStart(2, "0")}</span>
        <ArticleCard
          href={articleHref(essay)}
          title={essay.data.title}
          summary={essay.data.summary}
          date={essay.data.pubDate}
          kind="随笔"
          eyebrow={essay.data.tags[0]}
        />
      </div>
    ))}
  </section>
</BaseLayout>

<script>
  import { setupScrollReveal } from "../../scripts/reveal";

  setupScrollReveal();
</script>
