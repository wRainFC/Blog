---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/article/ArticleCard.astro";
import { getPublishedEssays, getTopicSummaries } from "../../lib/content/queries";
import { articleHref, articleMotionId, topicHref } from "../../lib/content/urls";

const essays = await getPublishedEssays();
const topicSummaries = await getTopicSummaries();
const essayTags = new Set(essays.flatMap((essay) => essay.data.tags));
const essayTopics = topicSummaries.filter((topic) => essayTags.has(topic.tag));
const yearGroups = [...essays.reduce((groups, essay) => {
  const year = essay.data.pubDate.getFullYear();
  const entries = groups.get(year) ?? [];
  entries.push(essay);
  groups.set(year, entries);
  return groups;
}, new Map<number, typeof essays>())].sort(([a], [b]) => b - a);
---

<BaseLayout title="随笔思考｜楚地之雨" description="关于学习、成长和日常观察的个人随笔。" pageKind="archive">
  <section class="page-hero compact-hero essay-hero">
    <p class="section-index">ESSAYS & THOUGHTS</p>
    <h1>随笔与观察</h1>
    <p>记录学习之外的判断、经验，以及那些还没有标准答案的问题。</p>
  </section>
  <section class="essay-archive" data-pagefind-body data-reveal>
    {essayTopics.length > 0 && (
      <div class="essay-topics reveal-item">
        <p>随笔主题</p>
        <div class="tag-cloud">
          {essayTopics.map((topic) => <a href={topicHref(topic.tag)}>#{topic.tag}<small>{topic.count}</small></a>)}
        </div>
      </div>
    )}
    {yearGroups.map(([year, entries]) => (
      <section class="writing-year reveal-item" aria-labelledby={`year-${year}`}>
        <header class="writing-year__heading">
          <h2 id={`year-${year}`}>{year}</h2>
          <span>{entries.length} 篇</span>
        </header>
        <div class="article-list">
          {entries.map((essay) => (
            <ArticleCard
              href={articleHref(essay)}
              title={essay.data.title}
              summary={essay.data.summary}
              date={essay.data.pubDate}
              kind="随笔"
              eyebrow={essay.data.tags[0]}
              motionId={articleMotionId(essay)}
            />
          ))}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>
