---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/article/ArticleCard.astro";
import { getCourseSummaries, getPublishedNotes } from "../../lib/content/queries";
import { articleHref, articleMotionId, courseHref, topicHref } from "../../lib/content/urls";

const [notes, courses] = await Promise.all([
  getPublishedNotes(),
  getCourseSummaries(),
]);
const tags = [...new Set(notes.flatMap((note) => note.data.tags))];
const courseNames = new Map(courses.map((course) => [course.id, course.data.title]));
---

<BaseLayout title="课程笔记｜楚地之雨" description="按课程、学期和主题整理的大学学习笔记。" pageKind="archive">
  <section class="page-hero compact-hero">
    <p class="section-index">COURSE NOTES</p>
    <h1>我们必须知道，<br />我们终将知道。</h1>
    <p>课程笔记</p>
  </section>

  <section class="archive-shell" data-pagefind-body data-reveal>
    <aside class="filter-panel reveal-item" data-pagefind-ignore>
      <div>
        <p>课程</p>
        {courses.map((course) => <a href={courseHref(course.id)}>{course.data.title}</a>)}
      </div>
      <div>
        <p>主题</p>
        <div class="tag-cloud">{tags.map((tag) => <a href={topicHref(tag)}>#{tag}</a>)}</div>
      </div>
    </aside>
    <div class="archive-content">
      <div class="archive-summary reveal-item"><span>共 {notes.length} 篇</span><i></i><span>{courses.length} 门课程</span></div>
      <div class="article-list">
        {notes.map((note) => (
          <ArticleCard
            href={articleHref(note)}
            title={note.data.title}
            summary={note.data.summary}
            date={note.data.pubDate}
            kind="笔记"
            eyebrow={`${courseNames.get(note.data.course.id)} · ${note.data.chapter}`}
            class="reveal-item"
            motionId={articleMotionId(note)}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
