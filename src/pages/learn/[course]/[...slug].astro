---
import { render } from "astro:content";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import { getCourseById, getCourseNavigation, getCourseOutline, getPublishedNotes, resolveCourseChapter } from "../../../lib/content/queries";
import { readingTime } from "../../../lib/content/format";
import { articleMotionId } from "../../../lib/content/urls";

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return notes.map((entry) => {
    const courseId = entry.data.course.id;
    const prefix = `${courseId}/`;
    const slug = entry.id.startsWith(prefix) ? entry.id.slice(prefix.length) : entry.id;
    return { params: { course: courseId, slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const course = await getCourseById(entry.data.course.id);
if (!course) throw new Error(`Course not found: ${entry.data.course.id}`);
const chapter = resolveCourseChapter(course, entry);
const courseOutline = await getCourseOutline(course.id);
const { previous, next } = getCourseNavigation(courseOutline, entry.id);
const { Content, headings } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  summary={entry.data.summary}
  pubDate={entry.data.pubDate}
  updated={entry.data.updated}
  tags={entry.data.tags}
  type="note"
  course={course}
  chapter={chapter.title}
  chapterId={chapter.id}
  courseOutline={courseOutline}
  currentNoteId={entry.id}
  previousNote={previous?.note}
  nextNote={next?.note}
  previousChapter={previous?.chapterTitle}
  nextChapter={next?.chapterTitle}
  headings={headings}
  readingTime={readingTime(entry.body)}
  motionId={articleMotionId(entry)}
>
  <Content />
</ArticleLayout>
